server {
    listen 80;
    server_name masters.example.com;  # Change to your domain/IP

    root /var/www/masters/dist;
    index index.html;

    # SPA routing - serve index.html for all routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy DataGolf API to avoid CORS
    location /api/datagolf/ {
        proxy_pass https://feeds.datagolf.com/;
        proxy_set_header Host feeds.datagolf.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_ssl_server_name on;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
